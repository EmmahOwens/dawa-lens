# Firebase Configuration
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# AI Service Keys
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY_2="your-gemini-api-key-2-for-scanning"
GROQ_API_KEY="your-groq-api-key"
GROQ_API_KEY_2="your-groq-api-key-2"
GROQ_API_KEY_3="your-groq-api-key-3"
OPENFDA_API="your-openfda-api-key"             # openFDA API key (240 req/min tier)
CEREBRAS_API_KEY="your-cerebras-api-key"       # Optional: enables fast 120B model for complex tasks
Z_AI_API_KEY="your-z-ai-api-key"               # Optional: enables GLM-4.7-Flash as fallback
CLOUDFLARE_API_KEY="your-cloudflare-api-key"   # Used for scan feature (Llama 3.2 Vision)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# Additional Zero-Payment / Free-Tier AI Providers (No Credit Card Required)
NVIDIA_API="your-nvidia-api-key"               # NVIDIA NIM free tier: nvidia/llama-3.1-nemotron-70b-instruct
SILICONFLOW_API="your-siliconflow-api-key"     # SiliconFlow free tier: Qwen/Qwen2.5-7B-Instruct
VOYAGEAI_API="your-voyage-ai-api-key"          # Voyage AI free tier (200M tokens): voyage-3-lite embeddings
SAMBACLOUD_API_KEY="your-sambanova-api-key"    # SambaNova Cloud free tier: Meta-Llama-3.3-70B-Instruct
OPENROUTER_API_KEY="your-openrouter-api-key"   # OpenRouter free tier (:free models)
MISTRAL_API_KEY="your-mistral-api-key"         # Mistral AI free Experiment tier: mistral-small-latest

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
PORT=5000
NODE_ENV="development"

